<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.organizador.escolar">

    <!-- Permisos para notificaciones y hápticos -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Actividad Principal (Capacitor Bridge WebView) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Esquema de enlace profundo para acciones rápidas desde Widgets -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="organizador" android:host="app" />
            </intent-filter>
        </activity>

        <!-- ======================================================== -->
        <!-- WIDGET 1: ACCIÓN RÁPIDA DE TAREAS (QUICK TASK)          -->
        <!-- ======================================================== -->
        <receiver
            android:name=".widgets.QuickTaskWidget"
            android:exported="true"
            android:label="@string/widget_quick_task_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_task_widget_info" />
        </receiver>

        <!-- ======================================================== -->
        <!-- WIDGET 2: CALENDARIO DE 1 O 2 SEMANAS (WEEK CALENDAR)    -->
        <!-- ======================================================== -->
        <receiver
            android:name=".widgets.WeekCalendarWidget"
            android:exported="true"
            android:label="@string/widget_week_calendar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_calendar_widget_info" />
        </receiver>

        <!-- ======================================================== -->
        <!-- WIDGET 3: FECHAS DE ENTREGA DE TAREAS (TASK DEADLINES)   -->
        <!-- ======================================================== -->
        <receiver
            android:name=".widgets.TaskDeadlinesWidget"
            android:exported="true"
            android:label="@string/widget_task_deadlines_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_deadlines_widget_info" />
        </receiver>

        <!-- Servicio de RemoteViews para la lista del Widget 3 -->
        <service
            android:name=".widgets.TaskDeadlinesService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

</manifest>
