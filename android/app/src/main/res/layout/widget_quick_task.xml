<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_task_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Lado Izquierdo: Contador de Pendientes y Próxima Tarea -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Cabecera Institucional y Etiqueta -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_quick_task_inst_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNAM"
                android:textColor="@color/unam_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="• Hoy"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Contador Grande de Pendientes de Hoy -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="baseline"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_quick_task_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/widget_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_quick_task_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="tareas pendientes"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Detalle de la Próxima Tarea Urgente -->
        <TextView
            android:id="@+id/widget_quick_task_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Todo al corriente para hoy ✨"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Lado Derecho: Botón de Acción Rápida "+ Tarea" -->
    <LinearLayout
        android:id="@+id/widget_quick_task_btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_button_add"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Tarea"
            android:textColor="@color/widget_text_white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
